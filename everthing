import tkinter as tk


# -------------------------
# BALL CLASS
# -------------------------
class Ball:
    def __init__(self, canvas, x, y, radius, color, vx, vy):
        self.canvas = canvas
        self.x = x
        self.y = y
        self.radius = radius

        self.vx = vx
        self.vy = vy

        self.gravity = 0.4
        self.restitution = 0.85

        self.ball = canvas.create_oval(
            x - radius,
            y - radius,
            x + radius,
            y + radius,
            fill=color
        )

    def update(self):
        # Apply gravity
        self.vy += self.gravity

        # Update position
        self.x += self.vx
        self.y += self.vy

        width = self.canvas.winfo_width()
        height = self.canvas.winfo_height()

        # Floor collision
        if self.y + self.radius >= height:
            self.y = height - self.radius
            self.vy = -self.vy * self.restitution

        # Ceiling collision
        if self.y - self.radius <= 0:
            self.y = self.radius
            self.vy = -self.vy

        # Left wall collision
        if self.x - self.radius <= 0:
            self.x = self.radius
            self.vx = -self.vx

        # Right wall collision
        if self.x + self.radius >= width:
            self.x = width - self.radius
            self.vx = -self.vx

        self.canvas.coords(
            self.ball,
            self.x - self.radius,
            self.y - self.radius,
            self.x + self.radius,
            self.y + self.radius
        )


# -------------------------
# SIMULATION CLASS
# -------------------------
class BouncingBalls:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Three Bouncing Balls")

        self.canvas = tk.Canvas(
            self.root,
            width=800,
            height=500,
            bg="white"
        )
        self.canvas.pack()

        # Three Ball Objects
        self.balls = [
            Ball(self.canvas, 150, 100, 20, "red", 4, -5),
            Ball(self.canvas, 350, 150, 20, "blue", -3, -8),
            Ball(self.canvas, 550, 200, 20, "green", 5, -6)
        ]

        self.animate()

        self.root.mainloop()

    def animate(self):
        for ball in self.balls:
            ball.update()

        self.root.after(20, self.animate)


# -------------------------
# MAIN PROGRAM
# -------------------------
if __name__ == "__main__":
    BouncingBalls()